# Copie para ".env" na raiz do projeto e ajuste antes do primeiro `docker compose up`.

POSTGRES_USER=gastei
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=gastei

# Porta exposta da API no host — clique nela como no Immich (2283:2283)
GASTEI_PORT=3283

# Gere com: openssl rand -hex 32
JWT_ACCESS_SECRET=troque-este-segredo

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=365
