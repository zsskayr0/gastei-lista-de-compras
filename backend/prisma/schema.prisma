generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FamilyRole {
  owner
  admin
  member
}

enum InviteStatus {
  pending
  used
  canceled
  expired
}

enum ListFolder {
  inbox
  casa
  corporativo
}

enum ListStatus {
  active
  archived
  deleted
}

enum ListPhase {
  montar
  comprar
}

enum ListItemState {
  pending
  checked
  removed
}

enum ItemFrequency {
  recorrente
  rara
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  deviceSessions      DeviceSession[]
  familyMemberships   FamilyMember[]
  ownedFamilies       Family[]              @relation("FamilyOwner")
  createdInvites      Invite[]              @relation("InviteCreatedBy")
  usedInvites         Invite[]              @relation("InviteUsedBy")
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model DeviceSession {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  deviceName            String?   @map("device_name")
  refreshTokenHash      String    @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime  @map("refresh_token_expires_at")
  lastSyncedAt          DateTime? @map("last_synced_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  revokedAt             DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Family {
  id          String    @id @default(uuid())
  name        String
  ownerUserId String    @map("owner_user_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  owner           User             @relation("FamilyOwner", fields: [ownerUserId], references: [id])
  members         FamilyMember[]
  invites         Invite[]
  lists           List[]
  catalogItems    CatalogItem[]
  categories      Category[]
  templates       Template[]
  dictionaryTerms DictionaryTerm[]

  @@map("families")
}

model FamilyMember {
  id       String     @id @default(uuid())
  familyId String     @map("family_id")
  userId   String     @map("user_id")
  role     FamilyRole
  joinedAt DateTime   @default(now()) @map("joined_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
  @@map("family_members")
}

model Invite {
  id             String       @id @default(uuid())
  familyId       String       @map("family_id")
  createdByUserId String      @map("created_by_user_id")
  token          String       @unique
  status         InviteStatus @default(pending)
  createdAt      DateTime     @default(now()) @map("created_at")
  expiresAt      DateTime     @map("expires_at")
  usedByUserId   String?      @map("used_by_user_id")
  usedAt         DateTime?    @map("used_at")

  family      Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User   @relation("InviteCreatedBy", fields: [createdByUserId], references: [id])
  usedBy      User?  @relation("InviteUsedBy", fields: [usedByUserId], references: [id])

  @@index([familyId])
  @@map("invites")
}

model Category {
  id       String @id @default(uuid())
  familyId String @map("family_id")
  name     String
  color    String
  icon     String

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  catalogItems CatalogItem[]
  listItems    ListItem[]

  @@index([familyId])
  @@map("categories")
}

model Template {
  id        String   @id @default(uuid())
  familyId  String   @map("family_id")
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  family    Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  items     TemplateItem[]
  lists     List[]

  @@index([familyId])
  @@map("templates")
}

model TemplateItem {
  id              String @id @default(uuid())
  templateId      String @map("template_id")
  catalogItemId   String @map("catalog_item_id")
  defaultQuantity Float? @map("default_quantity")

  template    Template    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("template_items")
}

model CatalogItem {
  id                String        @id @default(uuid())
  familyId          String        @map("family_id")
  name              String
  illustrationId    String?       @map("illustration_id")
  categoryId        String?       @map("category_id")
  frequency         ItemFrequency @default(rara)
  expectedQuantity  Float?        @map("expected_quantity")
  /// Quando a foto do item foi enviada pela última vez (null = sem foto). Serve de cache-buster.
  imageUpdatedAt    DateTime?     @map("image_updated_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  family        Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category      Category?        @relation(fields: [categoryId], references: [id])
  image         CatalogImage?
  templateItems TemplateItem[]
  dictionaryTerms DictionaryTerm[]

  @@index([familyId])
  @@map("catalog_items")
}

/// Foto do item de catálogo (já reduzida no cliente). Fica no banco para entrar no backup junto.
model CatalogImage {
  catalogItemId String   @id @map("catalog_item_id")
  mime          String
  data          Bytes
  updatedAt     DateTime @updatedAt @map("updated_at")

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@map("catalog_images")
}

model DictionaryTerm {
  id                       String    @id @default(uuid())
  familyId                 String    @map("family_id")
  term                     String
  guessedCategoryId        String?   @map("guessed_category_id")
  usageCount               Int       @default(1) @map("usage_count")
  wasCorrected             Boolean   @default(false) @map("was_corrected")
  promotedToCatalogItemId  String?   @map("promoted_to_catalog_item_id")
  firstSeenAt              DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt               DateTime  @default(now()) @map("last_seen_at")

  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem? @relation(fields: [promotedToCatalogItemId], references: [id])

  @@unique([familyId, term])
  @@map("dictionary_terms")
}

model List {
  id                      String     @id @default(uuid())
  familyId                String     @map("family_id")
  folder                  ListFolder
  title                   String
  status                  ListStatus @default(active)
  phase                   ListPhase?
  purchasePhaseStartedAt  DateTime?  @map("purchase_phase_started_at")
  templateId              String?    @map("template_id")
  createdAt               DateTime   @default(now()) @map("created_at")
  closedAt                DateTime?  @map("closed_at")
  deletedAt               DateTime?  @map("deleted_at")

  family     Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  template   Template?     @relation(fields: [templateId], references: [id])
  items      ListItem[]
  syncEvents SyncEvent[]
  history    ArchivedList?

  @@index([familyId])
  @@map("lists")
}

model ListItem {
  id                     String        @id @default(uuid())
  listId                 String        @map("list_id")
  catalogItemId          String?       @map("catalog_item_id")
  name                   String
  categoryId             String?       @map("category_id")
  quantityExpected       Float?        @map("quantity_expected")
  quantityPlanned        Float?        @map("quantity_planned")
  quantityBought         Float?        @map("quantity_bought")
  state                  ListItemState @default(pending)
  isCarryover            Boolean       @default(false) @map("is_carryover")
  addedByUserId          String        @map("added_by_user_id")
  addedAt                DateTime      @default(now()) @map("added_at")
  checkedByUserId        String?       @map("checked_by_user_id")
  checkedAt              DateTime?     @map("checked_at")
  lastModifiedByUserId   String        @map("last_modified_by_user_id")
  lastModifiedAt         DateTime      @default(now()) @map("last_modified_at")
  lastModifiedField      String?       @map("last_modified_field")
  deletedAt              DateTime?     @map("deleted_at")
  note                   String?

  list     List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([listId])
  @@map("list_items")
}

model ArchivedList {
  id        String     @id @default(uuid())
  listId    String     @unique @map("list_id")
  folder    ListFolder
  closedAt  DateTime   @map("closed_at")
  snapshot  Json

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@map("archived_lists")
}

model SyncEvent {
  id              String   @id @default(uuid())
  familyId        String   @map("family_id")
  listId          String   @map("list_id")
  entityType      String   @map("entity_type")
  entityId        String   @map("entity_id")
  field           String
  value           Json
  actorUserId     String   @map("actor_user_id")
  actorDeviceId   String   @map("actor_device_id")
  clientTimestamp DateTime @map("client_timestamp")
  serverTimestamp DateTime @default(now()) @map("server_timestamp")
  applied         Boolean  @default(false)

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId, serverTimestamp])
  @@index([familyId])
  @@map("sync_events")
}
