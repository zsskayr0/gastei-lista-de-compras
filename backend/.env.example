# Copie para .env.docker (ou .env) e ajuste antes do primeiro `docker compose up`.

# Postgres
POSTGRES_USER=gastei
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=gastei

# Porta exposta da API no host (siga o padrão "porta:porta", como o Immich 2283:2283)
GASTEI_PORT=3283

# Segredo dos access tokens JWT — gere algo aleatório, ex.: `openssl rand -hex 32`
JWT_ACCESS_SECRET=troque-este-segredo

# Duração do access token (curto — renovado via refresh silencioso)
ACCESS_TOKEN_TTL=15m

# Duração do refresh token em dias (janela deslizante, renovada a cada uso)
REFRESH_TOKEN_TTL_DAYS=90
